+-- Version: 1.0.0
+-- Scenario 56 (MU-1): a GitHub pull on one PC reaches every device over the mesh.
+--   #10 server PC (wired + ender modem, /files/, HTTP), #11 wired-only server PC, #20 relay,
+--   #30 pocket, turtles #1 #2 #3 mining (real miner, real startup). #3's modem is off during
+--   the update (out of range) and comes back later.
+--   GitHub has newer config.lua (turtles), tm_views.lua (computers), relay.lua (relays) and
+--   tmwords.lua (everyone). Checks: every device ends with the new files, each rebooted once
+--   for it, turtles installed only at home (never mid-trip), computers only once idle (a key
+--   pressed on #11 holds it back for 30 s), #3 catches up after it is heard again.
+local ENDER = "computercraft:wireless_modem_advanced"
+
+return {
+    title = "GitHub pull on one PC -> 2 PCs, relay, pocket, 3 turtles updated",
+    needs = { "net", "miner", "tmmesh", "tmguard", "updater", "startup" },
+    run = function(sim, H)
+        local Mesh = H.mesh()
+        local NEW = {
+            ["miner/config.lua"] = H.bump(H.repo("miner/config.lua"), "9.1.0"),
+            ["servers/tm_views.lua"] = H.bump(H.repo("servers/tm_views.lua"), "9.1.0"),
+            ["servers/relay.lua"] = H.bump(H.repo("servers/relay.lua"), "9.1.0"),
+            ["miner/tmwords.lua"] = H.bump(H.repo("miner/tmwords.lua"), "9.1.0"),
+        }
+        local gh = H.github({})
+        local wired = { side = "back", kind = "wired", net = "base" }
+        local A = H.meshComputer({ id = 10, role = "server", http = gh.fn,
+            modems = { wired, { side = "top", kind = "ender" } }, settings = { pull_minutes = 60 } })
+        local B = H.meshComputer({ id = 11, role = "server", modems = { wired } })
+        local R = H.meshComputer({ id = 20, role = "relay", modems = { { side = "top", kind = "ender" } } })
+        local P = H.meshComputer({ id = 30, role = "pocket", modems = { { side = "back", kind = "ender" } } })
+        local w = sim.world()
+        local turtles = {}
+        for i = 1, 3 do
+            local ctx = H.minerSetup({ id = i, w = w, home = { x = i * 20, y = 0, z = 0 },
+                settings = { AUTO_UPDATE = true, MAX_CORRIDORS = 6, MAIN_LENGTH = 16 } })
+            turtles[i] = ctx
+        end
+        -- passive status recorder only (no fleet heartbeats; the real PCs do that)
+        for _, ctx in ipairs(turtles) do ctx.srv = turtles[1].srv end
+        local applyAway = {}
+        sim.observe(function(e)
+            local c = e.computer
+            if c.turtle and (e.kind == "fs_move" or e.kind == "fs_copy") and e.to == "config.lua" then
+                local ctx = turtles[c.id]
+                if ctx and not H.samePos(c.turtle.pos, ctx.home) then applyAway[#applyAway + 1] = c.id end
+            end
+        end)
+        for _, ctx in ipairs(turtles) do sim.boot(ctx.t, { "startup" }, { background = true }) end
+        turtles[3].t.equip.left = nil          -- #3 out of range
+        sim.run({ maxTime = 60 })
+        local devs = { A.c, B.c, R.c, P.c, turtles[1].t.computer, turtles[2].t.computer, turtles[3].t.computer }
+        for _, c in ipairs(devs) do
+            H.check(c.alive, "#%d not running before the update: %s %s", c.id, tostring(c.status), tostring(c.err))
+        end
+        local boots0 = {}
+        for _, c in ipairs(devs) do boots0[c.id] = c.boots end
+        H.check(A.T() and A.T().mesh, "#10 has no mesh engine: %s", tostring(A.T() and A.T().S.meshErr))
+
+        -- GitHub gets newer files; #10 pulls (hourly backup -> here: Check now from its own UI code path)
+        for k, v in pairs(NEW) do gh.over[k] = v end
+        local t0 = sim.now
+        A.T().checkNow()
+        sim.key(B.c, B.c.env.keys.tab)           -- someone uses #11: it must wait 30 s idle
+        local function has(c, path, ver) return H.verOf(c, path) == ver end
+        local function done(c)
+            if c.turtle then return has(c, "config.lua", "9.1.0") and has(c, "tmwords.lua", "9.1.0") end
+            if c.id == 20 then return has(c, "relay.lua", "9.1.0") and has(c, "tmwords.lua", "9.1.0") end
+            local ok = has(c, "tm_views.lua", "9.1.0") and has(c, "tmwords.lua", "9.1.0")
+            if c.id == 10 then ok = ok and has(c, "files/config.lua", "9.1.0") and has(c, "files/relay.lua", "9.1.0") end
+            return ok
+        end
+        local doneAt = {}
+        local function track()
+            for _, c in ipairs(devs) do if not doneAt[c.id] and done(c) then doneAt[c.id] = sim.now - t0 end end
+        end
+        sim.run({ untilFn = function()
+            track()
+            for i = 1, 6 do if not doneAt[devs[i].id] then return false end end
+            return true
+        end, maxTime = 1800 })
+        local function logTail(c)
+            local T = c.env and c.env.TMINER_SERVER
+            if not T then return "" end
+            local l = {}
+            for i = math.max(1, #T.S.log - 12), #T.S.log do l[#l + 1] = T.S.log[i] end
+            return table.concat(l, " | ") .. " meshErr=" .. tostring(T.S.meshErr) .. " err=" .. tostring(c.errors and c.errors[#c.errors])
+        end
+        for i = 1, 6 do
+            local c = devs[i]
+            if not doneAt[c.id] then H.note("#" .. c.id .. " log: " .. logTail(c) .. " / #10: " .. logTail(A.c)) end
+            H.check(doneAt[c.id], "#%d not updated after 30 min (status %s %s; tm_views %s config %s relay %s)", c.id,
+                tostring(c.status), tostring(c.err), tostring(H.verOf(c, "tm_views.lua")), tostring(H.verOf(c, "config.lua")),
+                tostring(H.verOf(c, "relay.lua")))
+        end
+        H.check(not doneAt[3], "#3 updated while out of range")
+        H.check(doneAt[11] >= 30, "#11 updated %.1f s after the pull although a key was pressed (needs 30 s idle)", doneAt[11])
+        -- #3 comes back in range
+        local tBack = sim.now
+        turtles[3].t.equip.left = ENDER
+        sim.queue(turtles[3].t.computer, sim.now, { "peripheral", "left", n = 2 })
+        sim.run({ untilFn = function() track(); return doneAt[3] ~= nil end, maxTime = 1800 })
+        H.check(doneAt[3], "#3 did not catch up after coming back (config %s)", tostring(H.verOf(devs[7], "config.lua")))
+        sim.run({ maxTime = 120 })
+        H.check(#applyAway == 0, "turtle(s) installed away from home: %s", table.concat(applyAway, ","))
+        for _, c in ipairs(devs) do
+            H.check(c.alive, "#%d stopped: %s %s", c.id, tostring(c.status), tostring(c.err))
+            local n = c.boots - boots0[c.id]
+            H.check(n == 1, "#%d rebooted %d times for the update (want 1)", c.id, n)
+            H.check(not c.fs:read(".tm_mesh/rollback"), "#%d rolled back", c.id)
+        end
+        for _, ctx in ipairs(turtles) do H.commonChecks(ctx) end
+        local order = {}
+        for _, c in ipairs(devs) do order[#order + 1] = string.format("#%d %.0fs", c.id, doneAt[c.id]) end
+        local slowest = 0
+        for i = 1, 6 do slowest = math.max(slowest, doneAt[devs[i].id]) end
+        local n, by, bytes = H.meshTraffic(t0)
+        return string.format("all in-range devices updated within %.0f s (%s); #3 %.0f s after it came back; "
+            .. "1 reboot each; turtles at home only; mesh msgs %d (%d chunks, %d KB)",
+            slowest, table.concat(order, ", "), doneAt[3] - (tBack - t0), n, by.file_chunk or 0, math.floor(bytes / 1024))
+    end,
+}
diff --git a/test/scenarios/57_mesh_manual_edit.lua b/test/scenarios/57_mesh_manual_edit.lua
new file mode 100644
index 0000000..9cf989b
--- /dev/null
+++ b/test/scenarios/57_mesh_manual_edit.lua
@@ -0,0 +1,56 @@
+-- Version: 1.0.0
+-- Scenario 57 (MU-1): a file edited by hand (with its `-- Version:` bumped) on a wired-only
+-- PC spreads to every device that holds it.
+--   #10 server PC (wired + ender, /files/), #11 wired-only server PC (/files/), #30 pocket,
+--   turtle #1 mining. On #11 someone edits tm_ui.lua (computers) and files/mine.lua (turtles)
+--   and bumps both to 9.2.0; a second edit without a bump (tm_db.lua) is not released.
+--   Within the 10-minute check #11 signs both; #10 and the pocket install tm_ui.lua 9.2.0, #10
+--   keeps files/mine.lua 9.2.0 for the turtles and the turtle installs mine.lua at home.
+return {
+    title = "manual edit + version bump on a wired-only PC spreads",
+    needs = { "net", "miner", "tmmesh", "tmguard", "updater", "startup" },
+    run = function(sim, H)
+        local wired = { side = "back", kind = "wired", net = "base" }
+        local A = H.meshComputer({ id = 10, role = "server", modems = { wired, { side = "top", kind = "ender" } } })
+        local B = H.meshComputer({ id = 11, role = "server", modems = { wired } })
+        local P = H.meshComputer({ id = 30, role = "pocket", modems = { { side = "back", kind = "ender" } } })
+        local ctx = H.minerSetup({ id = 1, settings = { AUTO_UPDATE = true, MAX_CORRIDORS = 6, MAIN_LENGTH = 16 } })
+        sim.boot(ctx.t, { "startup" }, { background = true })
+        sim.run({ maxTime = 60 })
+        local tc = ctx.t.computer
+        -- the edit
+        local t0 = sim.now
+        B.c.fs:write("tm_ui.lua", H.bump(H.repo("servers/tm_ui.lua"), "9.2.0", "-- edited by hand on #11"))
+        B.c.fs:write("files/mine.lua", H.bump(H.repo("miner/mine.lua"), "9.2.0", "-- edited by hand on #11"))
+        B.c.fs:write("tm_db.lua", H.repo("servers/tm_db.lua") .. "\n-- edited, no version bump\n")
+        local doneAt = {}
+        local function check()
+            if not doneAt.A and H.verOf(A.c, "tm_ui.lua") == "9.2.0" and H.verOf(A.c, "files/mine.lua") == "9.2.0" then doneAt.A = sim.now - t0 end
+            if not doneAt.P and H.verOf(P.c, "tm_ui.lua") == "9.2.0" then doneAt.P = sim.now - t0 end
+            if not doneAt.T and H.verOf(tc, "mine.lua") == "9.2.0" then doneAt.T = sim.now - t0 end
+            return doneAt.A and doneAt.P and doneAt.T
+        end
+        sim.run({ untilFn = check, maxTime = 2400 })
+        local EB = B.T().mesh
+        local rel = EB.held("servers/tm_ui.lua")
+        H.check(rel and rel.version == "9.2.0" and rel.origin == 11 and rel.sig, "#11 did not sign its edit")
+        local relA = A.T().mesh.held("miner/mine.lua")
+        H.check(relA and relA.version == "9.2.0" and relA.origin == 11, "#10 does not hold #11's mine.lua release")
+        local log = table.concat(B.T().S.log, "\n")
+        H.check(doneAt.A and doneAt.P and doneAt.T, "not everywhere: #10 %s/%s, pocket %s, turtle %s",
+            tostring(H.verOf(A.c, "tm_ui.lua")), tostring(H.verOf(A.c, "files/mine.lua")), tostring(H.verOf(P.c, "tm_ui.lua")),
+            tostring(H.verOf(tc, "mine.lua")))
+        H.check(A.c.fs:read("tm_ui.lua") == B.c.fs:read("tm_ui.lua"), "#10 got different content")
+        -- the edit without a version bump stays local, with one warning
+        H.check(A.c.fs:read("tm_db.lua") == H.repo("servers/tm_db.lua"), "unbumped tm_db.lua edit spread")
+        H.check(B.c.fs:read("tm_db.lua") ~= H.repo("servers/tm_db.lua"), "#11's unbumped edit was overwritten")
+        local warned = 0
+        for k in pairs(EB.warnedKeys()) do if k:find("^e|servers/tm_db.lua") then warned = warned + 1 end end
+        H.check(warned == 1, "unbumped edit warned %d times on #11", warned)
+        sim.run({ maxTime = 60 })
+        for _, c in ipairs({ A.c, B.c, P.c, tc }) do H.check(c.alive, "#%d stopped: %s", c.id, tostring(c.err)) end
+        H.commonChecks(ctx)
+        return string.format("edit on wired-only #11 released at its 10-min check; #10 after %.0f s, pocket %.0f s, turtle %.0f s; unbumped edit kept local (1 warning)",
+            doneAt.A, doneAt.P, doneAt.T)
+    end,
+}
diff --git a/test/scenarios/58_mesh_broken_files.lua b/test/scenarios/58_mesh_broken_files.lua
new file mode 100644
index 0000000..8d37c11
--- /dev/null
+++ b/test/scenarios/58_mesh_broken_files.lua
@@ -0,0 +1,63 @@
+-- Version: 1.0.0
+-- Scenario 58 (MU-1): a file that fails load() or its hash never installs anywhere.
+--   #10 server PC (/files/, HTTP), #30 pocket, turtles #1 #2 (net.lua + mesh, no mining).
+--   A: GitHub has inv.lua and tm_views.lua 9.3.0 that don't compile: #10 refuses to sign them.
+--   B: a hand edit on #10 (files/nav.lua 9.3.0) with a syntax error: not released (one warning).
+--   C: a network member (#40) offers mine.lua 9.3.0 with a valid release note, but the file
+--      doesn't compile: every device refuses it (and stops asking for it).
+--   D: #40 offers state.lua 9.3.0 whose content changes on the way (hash mismatch): refused.
+return {
+    title = "files failing load() or hash never install",
+    needs = { "net", "tmmesh", "tmguard" },
+    run = function(sim, H)
+        local BAD = "-- Version: 9.3.0\nlocal x = = 1\n"
+        local gh = H.github({})
+        local A = H.meshComputer({ id = 10, role = "server", http = gh.fn, modems = { { side = "top", kind = "ender" } } })
+        local P = H.meshComputer({ id = 30, role = "pocket", modems = { { side = "back", kind = "ender" } } })
+        local w = sim.world()
+        local tcs = {}
+        for i = 1, 2 do
+            local t = sim.turtle(w, { id = i, pos = { x = i * 3, y = 0, z = 0 } })
+            tcs[i] = H.netTurtle(t)
+        end
+        sim.run({ maxTime = 30 })
+        -- A: broken files on GitHub
+        gh.over["miner/inv.lua"] = BAD
+        gh.over["servers/tm_views.lua"] = BAD
+        A.T().checkNow()
+        sim.run({ maxTime = 20 })
+        -- B: broken hand edit
+        A.c.fs:write("files/nav.lua", "-- Version: 9.3.0\nfunction (\n")
+        A.T().mesh.scan()
+        -- C + D: a network member with a broken file and a tampered transfer
+        local good = H.bump(H.repo("miner/state.lua"), "9.3.0")
+        local peer = H.fakePeer({ id = 40, files = { ["miner/mine.lua"] = BAD, ["miner/state.lua"] = good },
+            tamper = function(name, text) if name == "miner/state.lua" then return text:gsub("local", "LOCAL", 1) end return text end })
+        sim.run({ maxTime = 600 })
+        local log = table.concat(A.T().S.log, "\n")
+        H.check(log:find("inv.lua v9.3.0 does not compile", 1, true), "#10 did not refuse the broken GitHub file:\n%s", log:sub(-1200))
+        H.check(log:find("nav.lua 9.3.0 does not compile, not released", 1, true), "#10 did not refuse the broken edit:\n%s", log:sub(-1200))
+        local devs = { A.c, P.c, tcs[1], tcs[2] }
+        for _, c in ipairs(devs) do
+            local E = H.engineOf(c)
+            H.check(E, "#%d has no mesh engine", c.id)
+            for _, name in ipairs({ "miner/inv.lua", "servers/tm_views.lua", "miner/nav.lua", "miner/mine.lua", "miner/state.lua" }) do
+                local h = E.holds(name) and E.held(name)
+                if h and h.version == "9.3.0" then
+                    -- only #10's own broken edit, kept locally and never served (no signature)
+                    H.check(c.id == 10 and name == "miner/nav.lua" and h.sig == nil, "#%d holds %s 9.3.0", c.id, name)
+                end
+            end
+            for _, f in ipairs({ "inv.lua", "tm_views.lua", "mine.lua", "state.lua", "files/inv.lua", "files/mine.lua", "files/state.lua" }) do
+                H.check(H.verOf(c, f) ~= "9.3.0", "#%d installed %s 9.3.0", c.id, f)
+            end
+        end
+        -- refused, then left alone: a bounded number of requests
+        H.check(peer.chunks > 0 and peer.chunks <= 4 * 3 * 3, "#40 got %d chunk requests (want a few, bounded)", peer.chunks)
+        local before = peer.chunks
+        sim.run({ maxTime = 600 })
+        H.check(peer.chunks == before, "devices keep asking for refused files (%d more chunk requests)", peer.chunks - before)
+        for _, c in ipairs({ A.c, P.c }) do H.check(c.alive, "#%d stopped: %s", c.id, tostring(c.err)) end
+        return string.format("GitHub + hand-edited broken files not signed; broken / tampered releases from a member refused by all 4 devices (%d chunk requests, then none)", peer.chunks)
+    end,
+}
diff --git a/test/scenarios/59_mesh_rollback.lua b/test/scenarios/59_mesh_rollback.lua
new file mode 100644
index 0000000..ec72ea6
--- /dev/null
+++ b/test/scenarios/59_mesh_rollback.lua
@@ -0,0 +1,104 @@
+-- Version: 1.0.0
+-- Scenario 59 (MU-2): a release that crashes on boot is rolled back and blocked everywhere;
+-- a newer fixed version clears it.
+--   #10 server PC (wired + ender, /files/, HTTP), #11 wired-only PC, #30 pocket, #1 turtle
+--   (mining). GitHub gets tm_views.lua 9.4.0 that crashes tminer_server on #11 only and
+--   config.lua 9.4.0 that crashes the miner. #11 installs it, crashes, restores the .bak,
+--   restarts the old version and signs a bad mark; #10 and the pocket, already running it,
+--   roll back too; the turtle rolls back its own crash at home. The monitor log says
+--   "update tm_views.lua 9.4.0 rolled back on #11: crash: ...". Then 9.4.1 (fixed) spreads and
+--   clears the marks.
+return {
+    title = "crashing release rolls back everywhere; fixed version clears it",
+    needs = { "net", "miner", "tmmesh", "tmguard", "updater", "startup" },
+    run = function(sim, H)
+        local gh = H.github({})
+        local wired = { side = "back", kind = "wired", net = "base" }
+        local A = H.meshComputer({ id = 10, role = "server", http = gh.fn, modems = { wired, { side = "top", kind = "ender" } } })
+        local B = H.meshComputer({ id = 11, role = "server", modems = { wired } })
+        local P = H.meshComputer({ id = 30, role = "pocket", modems = { { side = "back", kind = "ender" } } })
+        local ctx = H.minerSetup({ id = 1, settings = { AUTO_UPDATE = true, MAX_CORRIDORS = 6, MAIN_LENGTH = 16 } })
+        sim.boot(ctx.t, { "startup" }, { background = true })
+        local tc = ctx.t.computer
+        sim.run({ maxTime = 60 })
+        local origViews = H.repo("servers/tm_views.lua")
+        local origCfg = H.repo("miner/config.lua")
+        local v0 = origViews:match("^%-%- Version: ([%d%.]+)")
+        local c0 = origCfg:match("^%-%- Version: ([%d%.]+)")
+        gh.over["servers/tm_views.lua"] = H.bump(origViews, "9.4.0", nil,
+            'if os.getComputerID() == 11 then error("boom on 11", 0) end')
+        gh.over["miner/config.lua"] = H.bump(origCfg, "9.4.0", nil, 'error("config boom", 0)')
+        A.T().checkNow()
+        local ran = {}
+        local comps = { A.c, B.c, P.c }
+        local function watch()
+            for _, c in ipairs(comps) do if H.verOf(c, "tm_views.lua") == "9.4.0" then ran[c.id] = true end end
+            if H.verOf(tc, "config.lua") == "9.4.0" then ran[1] = true end
+            -- the turtle crashes in the same instant it boots the new config: see its own mark
+            local ET = H.engineOf(tc)
+            for _, m in ipairs(ET and ET.badList() or {}) do if m.by == 1 then ran[1] = true end end
+        end
+        local function allBack()
+            watch()
+            for _, c in ipairs(comps) do
+                local E = H.engineOf(c)
+                if not (E and c.alive and H.verOf(c, "tm_views.lua") == v0 and #E.badList() >= 1) then return false end
+            end
+            return ran[11] and ran[1] and H.verOf(tc, "config.lua") == c0
+        end
+        sim.run({ untilFn = allBack, maxTime = 2400 })
+        local function state()
+            local o = {}
+            for _, c in ipairs(comps) do
+                local E = H.engineOf(c)
+                o[#o + 1] = string.format("#%d %s v%s marks %s", c.id, c.status, tostring(H.verOf(c, "tm_views.lua")),
+                    tostring(E and #E.badList()))
+            end
+            local ET = H.engineOf(tc)
+            local pend = {}
+            for _, p in ipairs(ET and ET.pending() or {}) do pend[#pend + 1] = p.name .. ">" .. p.want .. (p.staged and "s" or "") end
+            o[#o + 1] = "turtle config " .. tostring(H.verOf(tc, "config.lua")) .. " " .. tc.status .. " us " .. tostring(ET and ET.stateText())
+                .. " pending " .. table.concat(pend, ",") .. " phase " .. tostring(ctx.phase()) .. " bad " .. (function() local r = {} for _, m in ipairs(ET and ET.badList() or {}) do r[#r + 1] = table.concat(m.ids, "+") .. " by " .. m.by end return table.concat(r, "; ") end)()
+                .. " rb=" .. tostring(tc.fs:read(".tm_mesh/rollback")) .. " prob=" .. tostring(tc.fs:read(".tm_mesh/probation") ~= nil) .. " boots " .. tc.boots
+            return table.concat(o, "; ")
+        end
+        H.check(allBack(), "not rolled back everywhere: %s (ran: %s %s %s %s)", state(), tostring(ran[10]), tostring(ran[11]),
+            tostring(ran[30]), tostring(ran[1]))
+        sim.run({ untilFn = function()
+            return table.concat(A.T().S.log, "\n"):find("config.lua 9.4.0 rolled back on #1", 1, true) ~= nil
+        end, maxTime = 120 })
+        local logA = table.concat(A.T().S.log, "\n")
+        H.check(logA:find("update tm_views.lua 9.4.0 rolled back on #11: crash: ", 1, true),
+            "#10's log does not show the rollback:\n%s", logA:sub(-1500))
+        H.check(logA:find("config.lua 9.4.0 rolled back on #1: crash: ", 1, true), "turtle rollback not shown:\n%s", logA:sub(-1500))
+        -- blocked: nobody installs 9.4.0 again
+        sim.run({ maxTime = 300 })
+        for _, c in ipairs(comps) do
+            H.check(H.verOf(c, "tm_views.lua") == v0 and c.alive, "#%d: %s after the mark", c.id, tostring(H.verOf(c, "tm_views.lua")))
+        end
+        H.check(H.verOf(tc, "config.lua") == c0, "turtle reinstalled the bad config.lua")
+        -- the fix
+        gh.over["servers/tm_views.lua"] = H.bump(origViews, "9.4.1")
+        gh.over["miner/config.lua"] = H.bump(origCfg, "9.4.1")
+        local t1 = sim.now
+        A.T().checkNow()
+        sim.run({ untilFn = function()
+            for _, c in ipairs(comps) do
+                local E = H.engineOf(c)
+                if not (E and H.verOf(c, "tm_views.lua") == "9.4.1" and #E.badList() == 0) then return false end
+            end
+            return H.verOf(tc, "config.lua") == "9.4.1"
+        end, maxTime = 2400 })
+        H.check(H.verOf(tc, "config.lua") == "9.4.1", "turtle did not get the fix: %s", state())
+        for _, c in ipairs(comps) do
+            local E = H.engineOf(c)
+            H.check(H.verOf(c, "tm_views.lua") == "9.4.1", "#%d did not get the fix: %s", c.id, state())
+            H.check(#E.badList() == 0, "#%d still shows the bad mark", c.id)
+        end
+        sim.run({ maxTime = 60 })
+        for _, c in ipairs({ A.c, B.c, P.c, tc }) do H.check(c.alive, "#%d stopped: %s", c.id, tostring(c.err)) end
+        H.commonChecks(ctx)
+        return string.format("9.4.0 crashed #11 + turtle -> rolled back; #10%s pocket%s rolled back by mark; fix 9.4.1 everywhere after %.0f s, marks cleared",
+            ran[10] and " (was running it)" or "", ran[30] and " (was running it)" or " (blocked)", sim.now - t1)
+    end,
+}
diff --git a/test/scenarios/60_mesh_foreign_release.lua b/test/scenarios/60_mesh_foreign_release.lua
new file mode 100644
index 0000000..b521b33
--- /dev/null
+++ b/test/scenarios/60_mesh_foreign_release.lua
@@ -0,0 +1,63 @@
+-- Version: 1.0.0
+-- Scenario 60 (MU-1): foreign, unsigned and forged releases are ignored.
+--   #10 server PC (/files/), #30 pocket, turtle #1 (net.lua + mesh). Fake peers offer
+--   config.lua / tm_ui.lua / relay.lua 9.5.0:
+--     #41 unsigned messages, #42 another player's network (its own valid key),
+--     #43 our network's messages but release notes signed with the other key, plus a bad mark
+--         signed with the other key against a release everyone runs,
+--     #44 our network, but a release note changed after signing (version raised).
+--   Nothing is installed or staged anywhere, nobody rolls back, the unsigned/foreign peers are
+--   never even asked (their messages are dropped), no file transfer to #43/#44 starts.
+return {
+    title = "foreign / unsigned / forged releases ignored",
+    needs = { "net", "tmmesh", "tmguard" },
+    run = function(sim, H)
+        local netB = H.network("other", { "river", "torch", "birch", "creek" })
+        local A = H.meshComputer({ id = 10, role = "server", modems = { { side = "top", kind = "ender" } } })
+        local P = H.meshComputer({ id = 30, role = "pocket", modems = { { side = "back", kind = "ender" } } })
+        local w = sim.world()
+        local tc = H.netTurtle(sim.turtle(w, { id = 1, pos = { x = 0, y = 0, z = 0 } }))
+        sim.run({ maxTime = 30 })
+        local files = {
+            ["miner/config.lua"] = H.bump(H.repo("miner/config.lua"), "9.5.0"),
+            ["servers/tm_ui.lua"] = H.bump(H.repo("servers/tm_ui.lua"), "9.5.0"),
+            ["servers/relay.lua"] = H.bump(H.repo("servers/relay.lua"), "9.5.0"),
+        }
+        local netVer = H.repo("miner/net.lua"):match("^%-%- Version: ([%d%.]+)")
+        local forgedMark = { t = "bad", ids = { "miner/net.lua@" .. netVer, "servers/tm_db.lua@" .. H.repo("servers/tm_db.lua"):match("^%-%- Version: ([%d%.]+)") },
+            reason = "forged", by = 43, ts = H.epochMs() }
+        forgedMark.sig = H.signer(netB).mac(forgedMark)
+        local p41 = H.fakePeer({ id = 41, net = false, files = files })
+        local p42 = H.fakePeer({ id = 42, net = netB, files = files })
+        local p43 = H.fakePeer({ id = 43, noteNet = netB, files = files, marks = { forgedMark }, vs = { m = "aaaaaa", s = "aaaaaa", r = "aaaaaa", b = "aaaaaa" } })
+        local p44 = H.fakePeer({ id = 44, files = files, noteEdit = function(n) n.version = "9.6.0" end })
+        sim.run({ maxTime = 600 })
+        local devs = { A.c, P.c, tc }
+        for _, c in ipairs(devs) do
+            local E = H.engineOf(c)
+            H.check(E, "#%d has no mesh engine", c.id)
+            for name in pairs(files) do
+                if E.holds(name) then
+                    local v = E.heldVersion(name)
+                    H.check(v ~= "9.5.0" and v ~= "9.6.0", "#%d holds %s %s", c.id, name, tostring(v))
+                end
+            end
+            for _, p in ipairs(E.pending()) do
+                H.check(not files[p.repo], "#%d wants %s %s from a forged note", c.id, p.repo, tostring(p.want))
+            end
+            H.check(#E.badList() == 0, "#%d accepted the forged bad mark", c.id)
+            H.check(E.ready() ~= "rollback", "#%d wants to roll back", c.id)
+            for _, f in ipairs({ "config.lua", "tm_ui.lua", "files/config.lua", "files/relay.lua" }) do
+                local v = H.verOf(c, f)
+                H.check(v ~= "9.5.0" and v ~= "9.6.0", "#%d installed %s %s", c.id, f, tostring(v))
+            end
+            H.check(c.alive, "#%d stopped: %s", c.id, tostring(c.err))
+        end
+        H.check(p41.lists == 0 and p42.lists == 0, "unsigned/foreign peers were asked (%d, %d)", p41.lists, p42.lists)
+        H.check(p43.lists > 0 and p44.lists > 0, "signed peers were never asked (test setup)")
+        H.check(p43.chunks == 0 and p44.chunks == 0, "a transfer of a forged release started (%d, %d chunk requests)", p43.chunks, p44.chunks)
+        H.check(A.T().S.bad > 0 and tc.net.stats.bad > 0, "unsigned/foreign messages not counted as bad")
+        return string.format("4 forged sources: none installed/staged on 3 devices; foreign/unsigned never asked (bad: #10 %d, turtle %d); forged notes/mark rejected (%d+%d list requests, 0 transfers)",
+            A.T().S.bad, tc.net.stats.bad, p43.lists, p44.lists)
+    end,
+}
diff --git a/test/scenarios/61_mesh_check_now.lua b/test/scenarios/61_mesh_check_now.lua
new file mode 100644
index 0000000..9b70e59
--- /dev/null
+++ b/test/scenarios/61_mesh_check_now.lua
@@ -0,0 +1,122 @@
+-- Version: 1.0.0
+-- Scenario 61 (MU-3 + MU-1 lists):
+--  A: the file lists agree: setup.lua (stand-alone, own copy), tmmesh.SETS (the source of
+--     truth), install.lua REQUIRED, the simulator's shared files.
+--  B: "Check now" on the UPDATES screen of a wired-only PC without HTTP (#11), keyboard only:
+--     it asks; #10 (HTTP + /files/) pulls from GitHub at once and answers; #11's screen shows
+--     the result; the new file reaches #11 by mesh.
+--  C: `updater --pull` on another computer: same, printed.
+local function listOf(src, var)
+    local body = src:match("local " .. var .. " = (%b{})")
+    local out = {}
+    if body then for n in body:gmatch('"([^"]+)"') do out[#out + 1] = n end end
+    return out
+end
+
+local function set(list)
+    local s = {}
+    for _, x in ipairs(list) do s[x] = true end
+    return s
+end
+
+local function same(a, b)
+    for k in pairs(a) do if not b[k] then return false, k end end
+    for k in pairs(b) do if not a[k] then return false, k end end
+    return true
+end
+
+return {
+    title = "Check now (keyboard) + updater --pull; file lists agree",
+    needs = { "net", "tmmesh", "tmguard", "updater" },
+    needsFile = "setup.lua",
+    run = function(sim, H)
+        -- A: lists ------------------------------------------------------------------------
+        local Mesh = H.mesh()
+        local setup = H.repo("setup.lua")
+        local function locals(setName, prefix)
+            local s = {}
+            for _, n in ipairs(Mesh.SETS[setName]) do
+                if n:sub(1, #prefix) == prefix then s[Mesh.localName(n)] = true end
+            end
+            return s
+        end
+        local MINER, NETM = listOf(setup, "MINER"), listOf(setup, "NETMODS")
+        local SERVER, RELAY = listOf(setup, "SERVER"), listOf(setup, "RELAY")
+        local ok, diff = same(set(MINER), locals("miner", "miner/"))
+        H.check(ok, "setup MINER vs tmmesh miner set: %s", tostring(diff))
+        local net = {}
+        for _, n in ipairs(Mesh.NET_MODS) do if n:sub(1, 6) == "miner/" then net[Mesh.localName(n)] = true end end
+        ok, diff = same(set(NETM), net)
+        H.check(ok, "setup NETMODS vs tmmesh NET_MODS: %s", tostring(diff))
+        local srv = set(SERVER)
+        srv["tminer_startup.lua"], srv["github_pull.lua"] = true, true    -- installed by name in setup
+        ok, diff = same(srv, locals("server", "servers/"))
+        H.check(ok, "setup SERVER vs tmmesh server set: %s", tostring(diff))
+        ok, diff = same(set(RELAY), locals("relay", "servers/"))
+        H.check(ok, "setup RELAY vs tmmesh relay set: %s", tostring(diff))
+        H.check(setup:find('shell.run("relay_startup")', 1, true) and setup:find('"servers/startup.lua", "tminer_startup.lua"', 1, true),
+            "setup does not install the startups the mesh keeps current")
+        local req = listOf(H.repo("miner/install.lua"), "REQUIRED")
+        local ms = locals("miner", "miner/")
+        for _, n in ipairs(req) do H.check(ms[n], "install REQUIRED %s not in the miner set", n) end
+        for _, n in ipairs(H.SHARED_FILES) do H.check(net[n], "sim shared file %s not a NET module", n) end
+        for _, n in ipairs(Mesh.NET_MODS) do
+            for _, s in ipairs({ "miner", "server", "relay" }) do
+                H.check(set(Mesh.SETS[s])[n], "%s missing from the %s set", n, s)
+            end
+        end
+        H.check(set(Mesh.NET_MODS)["setup.lua"], "setup.lua is not kept current by mesh updates")
+
+        -- B: Check now ----------------------------------------------------------------------
+        local gh = H.github({})
+        local wired = { side = "back", kind = "wired", net = "base" }
+        local A = H.meshComputer({ id = 10, role = "server", http = gh.fn, modems = { wired, { side = "top", kind = "ender" } },
+            settings = { pull_minutes = 0 } })
+        local B = H.meshComputer({ id = 11, role = "server", modems = { wired }, basic = true })
+        sim.run({ maxTime = 40 })
+        local gets0 = gh.gets
+        gh.over["servers/tm_views.lua"] = H.bump(H.repo("servers/tm_views.lua"), "9.6.0")
+        local T = B.T()
+        local ui
+        for _, u in ipairs(T.S.uis) do if u.side == nil then ui = u end end
+        H.check(ui, "#11 has no terminal UI")
+        local K = B.c.env.keys
+        local function press(k) sim.key(B.c, k); sim.run({ maxTime = 0.1 }) end
+        local function activate(label)
+            for _ = 1, 80 do
+                local b = ui.focus and ui.buttons[ui.focus]
+                if b and b.key == label then press(K.enter); return end
+                press(K.tab)
+            end
+            H.fail("no button %q on #11:\n%s", label, B.c.term._text())
+        end
+        activate("UPD")
+        H.check(ui.view == "updates", "UPDATES screen not open (view %s)", tostring(ui.view))
+        local tAsk = sim.now
+        activate("CHECK NOW")
+        sim.run({ untilFn = function() return T.S.pullMsg and T.S.pullMsg:find("pulled", 1, true) ~= nil end, maxTime = 30 })
+        H.check(gh.gets > gets0, "#10 did not pull from GitHub")
+        H.check(T.S.pullMsg and T.S.pullMsg:find("#10 pulled: 1 new file", 1, true), "#11 shows: %s", tostring(T.S.pullMsg))
+        local tPulled = sim.now - tAsk
+        sim.run({ maxTime = 1 })
+        H.check(B.c.term._text():find("#10 pulled: 1 new file", 1, true), "result not on #11's screen:\n%s", B.c.term._text())
+        sim.run({ untilFn = function() return H.verOf(B.c, "tm_views.lua") == "9.6.0" and B.c.alive and B.T() and B.T().S end,
+            maxTime = 600 })
+        H.check(H.verOf(B.c, "tm_views.lua") == "9.6.0", "the pulled file did not reach #11")
+        local tSpread = sim.now - tAsk
+
+        -- C: updater --pull ----------------------------------------------------------------
+        gh.over["servers/tm_ui.lua"] = H.bump(H.repo("servers/tm_ui.lua"), "9.6.0")
+        local C = sim.computer({ id = 12, label = "cli", modems = { { side = "back", kind = "ender" } } })
+        H.installShared(C)
+        local r = sim.boot(C, { "updater", "--pull" }, { maxTime = 120 })
+        local out = table.concat(C.output)
+        H.check(r.status == "exit", "updater --pull: %s %s", r.status, tostring(r.err))
+        H.check(out:find("#10 pulled from GitHub: 1 new file", 1, true), "updater --pull printed:\n%s", out)
+        sim.run({ untilFn = function() return H.verOf(B.c, "tm_ui.lua") == "9.6.0" end, maxTime = 600 })
+        H.check(H.verOf(B.c, "tm_ui.lua") == "9.6.0", "updater --pull result did not spread to #11")
+        H.check(#B.c.term._violations == 0, "#11 wrote off screen")
+        return string.format("lists agree (setup/tmmesh/install/sim); Check now on basic wired-only #11 (keyboard): pulled in %.1f s, on #11 after %.0f s; updater --pull ok",
+            tPulled, tSpread)
+    end,
+}
diff --git a/test/scenarios/62_mesh_traffic.lua b/test/scenarios/62_mesh_traffic.lua
new file mode 100644
index 0000000..c8ab494
--- /dev/null
+++ b/test/scenarios/62_mesh_traffic.lua
@@ -0,0 +1,110 @@
+-- Version: 1.0.0
+-- Scenario 62 (MU-1): traffic bound with 20 devices.
+--   3 server PCs (#10 wired + ender, /files/, HTTP; #11 wired + ender; #12 wired-only),
+--   2 relays (#20, #21), 1 pocket (#30), 14 turtles (#101..#114, net.lua + mesh).
+--   One GitHub pull with 4 newer files (one per set + a shared one). Counts every mesh
+--   transmission (originals and relayed copies) until every device holds the new files, and
+--   checks it is bounded: at most 3 list requests per device (retries included), at most twice the chunk
+--   requests strictly needed, and quiet afterwards (no storm).
+return {
+    title = "20 devices: transmissions per update are bounded",
+    needs = { "net", "tmmesh", "tmguard" },
+    run = function(sim, H)
+        local Mesh = H.mesh()
+        local gh = H.github({})
+        local wired = { side = "back", kind = "wired", net = "base" }
+        local comps = {
+            H.meshComputer({ id = 10, role = "server", http = gh.fn, modems = { wired, { side = "top", kind = "ender" } } }),
+            H.meshComputer({ id = 11, role = "server", modems = { wired, { side = "top", kind = "ender" } } }),
+            H.meshComputer({ id = 12, role = "monitor", modems = { wired } }),
+            H.meshComputer({ id = 20, role = "relay", modems = { { side = "top", kind = "ender" } } }),
+            H.meshComputer({ id = 21, role = "relay", modems = { { side = "top", kind = "ender" } } }),
+            H.meshComputer({ id = 30, role = "pocket", modems = { { side = "back", kind = "ender" } } }),
+        }
+        local w = sim.world()
+        local tcs = {}
+        for i = 1, 14 do tcs[i] = H.netTurtle(sim.turtle(w, { id = 100 + i, pos = { x = i * 2, y = 0, z = 0 } })) end
+        sim.run({ maxTime = 120 })
+        -- quiet baseline
+        local tb = sim.now
+        sim.run({ maxTime = 300 })
+        local baseN = H.meshTraffic(tb, { list_get = true, files_list = true, file_get = true, file_chunk = true })
+        local NEW = {
+            ["miner/config.lua"] = H.bump(H.repo("miner/config.lua"), "9.7.0"),
+            ["servers/tm_views.lua"] = H.bump(H.repo("servers/tm_views.lua"), "9.7.0"),
+            ["servers/relay.lua"] = H.bump(H.repo("servers/relay.lua"), "9.7.0"),
+            ["miner/tmwords.lua"] = H.bump(H.repo("miner/tmwords.lua"), "9.7.0"),
+        }
+        for k, v in pairs(NEW) do gh.over[k] = v end
+        -- chunk requests strictly needed: each device fetches each of its new files once
+        local need = 0
+        local function chunksFor(name) return math.ceil(#NEW[name] / Mesh.CHUNK) end
+        local devices = {}
+        for _, d in ipairs(comps) do devices[#devices + 1] = { c = d.c, role = d.role } end
+        for _, c in ipairs(tcs) do devices[#devices + 1] = { c = c, role = "turtle" } end
+        local function heldAll(d)
+            local E = H.engineOf(d.c)
+            if d.role == "relay" then
+                return H.verOf(d.c, "relay.lua") == "9.7.0" and H.verOf(d.c, "tmwords.lua") == "9.7.0"
+            end
+            if not E then return false end
+            for name in pairs(NEW) do
+                if E.holds(name) and E.heldVersion(name) ~= "9.7.0" then return false end
+            end
+            return true
+        end
+        for _, d in ipairs(devices) do
+            if d.c.id ~= 10 then
+                local L = Mesh.layout(d.role == "monitor" and "server" or d.role, nil)
+                for name in pairs(NEW) do if L.paths[name] then need = need + chunksFor(name) end end
+            end
+        end
+        local t0 = sim.now
+        comps[1].T().checkNow()
+        local doneAt = nil
+        sim.run({ untilFn = function()
+            for _, d in ipairs(devices) do if not heldAll(d) then return false end end
+            doneAt = sim.now
+            return true
+        end, maxTime = 1800 })
+        local missing = {}
+        for _, d in ipairs(devices) do if not heldAll(d) then missing[#missing + 1] = "#" .. d.c.id end end
+        H.check(#missing == 0, "not updated after 30 min: %s", table.concat(missing, " "))
+        local n, by, bytes = H.meshTraffic(t0)
+        local lists = H.originals("list_get", t0)
+        local _, nList = H.originals("list_get", t0)
+        local _, nGet = H.originals("file_get", t0)
+        local _, nChunk = H.originals("file_chunk", t0)
+        local all = 0
+        for _, e in ipairs(sim.net.log) do if e.time >= t0 then all = all + 1 end end
+        local trace = {}
+        for _, e in ipairs(sim.net.log) do
+            local m = e.msg
+            if e.time >= t0 and type(m) == "table" and e.from == m.from and (m.hops or 0) == 0 then
+                if (m.kind == "list_get" and m.from == 110) or (m.from == 10 and (m.kind == "fleet" or m.kind == "cluster_hello") ) then
+                    if m.kind == "list_get" or #trace < 60 then
+                        trace[#trace + 1] = string.format("%.0f %s>%s %s", e.time - t0, m.kind, tostring(m.to), m.vs and (tostring(m.vs.m) .. "/" .. tostring(m.vs.s)) or "")
+                    end
+                end
+            end
+        end
+        H.note(table.concat(trace, "; "))
+        local per = {}
+        for id, k in pairs(lists) do per[#per + 1] = id .. ":" .. k end
+        table.sort(per)
+        H.check(nList <= 3 * #devices, "%d list requests for %d devices (%s)", nList, #devices, table.concat(per, " "))
+        H.check(nGet <= 2 * need, "%d chunk requests, %d needed", nGet, need)
+        -- quiet afterwards
+        local tq = sim.now
+        sim.run({ maxTime = 600 })
+        local after = H.meshTraffic(tq, { list_get = true, files_list = true, file_get = true, file_chunk = true })
+        H.check(after <= baseN + 2 * #devices, "still busy after the update: %d list/file messages in 10 min (baseline %d / 5 min)",
+            after, baseN)
+        for _, d in ipairs(devices) do H.check(d.c.alive, "#%d stopped: %s", d.c.id, tostring(d.c.err)) end
+        local _ = lists
+        return string.format("20 devices, 4 files: all had them %.0f s after the pull; mesh transmissions %d (incl. relayed copies; "
+            .. "originals: %d list_get, %d file_get [%d needed], %d file_chunk; %d KB chunk data on air); all messages in that time %d; "
+            .. "quiet afterwards (%d list/file msgs in 10 min)",
+            doneAt - t0, n, nList, nGet, need, nChunk, math.floor(bytes / 1024), all, after)
+    end,
+}
